    {
      "name": "Webhooks",
      "item": [
        {
          "name": "POST Simulate Stripe Webhook",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"received === true\", () => pm.expect(j.received).to.eql(true));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Signature Stripe simulée (HMAC-SHA256 de \"timestamp.payload\")",
                  "const secret = pm.environment.get(\"stripe_webhook_secret\");",
                  "const payload = pm.variables.replaceIn(pm.request.body.raw);",
                  "const ts = Math.floor(Date.now() / 1000);",
                  "const sig = CryptoJS.HmacSHA256(ts + \".\" + payload, secret).toString();",
                  "pm.request.body.raw = payload;",
                  "pm.request.headers.upsert({ key: \"Stripe-Signature\", value: `t=${ts},v1=${sig}` });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/webhooks/stripe",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "webhooks",
                "stripe"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"type\":\"payment_intent.succeeded\",\"data\":{\"object\":{\"id\":\"pi_test_123\",\"amount\":500,\"metadata\":{\"user_id\":\"{{user_id}}\",\"plan\":\"premium\"}}}}"
            }
          }
        },
        {
          "name": "POST Webhook sans signature",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"success === false\", () => pm.expect(j.success).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
